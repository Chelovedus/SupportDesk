{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Database": {
    "MigrateOnStartup": false,
    "SeedOnStartup": false
  },
  "OutboxProcessor": {
    "Enabled": false,
    "IntervalSeconds": 5,
    "BatchSize": 20,
    "MaxRetryCount": 3
  },
  "AllowedHosts": "*"
}
