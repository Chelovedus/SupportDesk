### Root
@SupportDesk_Host = http://localhost:5042


### Login as User
POST {{SupportDesk_Host}}/api/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "Password123!"
}

> {%
    client.global.set("user_token", response.body.accessToken);
    client.global.set("user_id", response.body.userId);
    client.global.set("user_email", response.body.email);
    client.global.set("user_role", response.body.role);
%}


### Login as Agent
POST {{SupportDesk_Host}}/api/auth/login
Content-Type: application/json

{
  "email": "agent@example.com",
  "password": "Password123!"
}

> {%
    client.global.set("agent_token", response.body.accessToken);
    client.global.set("agent_id", response.body.userId);
    client.global.set("agent_email", response.body.email);
    client.global.set("agent_role", response.body.role);
%}


### Login as Admin
POST {{SupportDesk_Host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Password123!"
}

> {%
    client.global.set("admin_token", response.body.accessToken);
    client.global.set("admin_id", response.body.userId);
    client.global.set("admin_email", response.body.email);
    client.global.set("admin_role", response.body.role);
%}


### Health
GET {{SupportDesk_Host}}/api/health
Accept: application/json


### Create ticket as User
POST {{SupportDesk_Host}}/api/tickets
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "title": "Cannot access internal portal",
  "description": "User cannot log in to the internal company portal.",
  "priority": "High"
}

> {% client.global.set("ticket_id", response.body.id); %}


### Create ticket as Admin
POST {{SupportDesk_Host}}/api/tickets
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "title": "Cannot access internal portal as admin",
  "description": "Admin creates a ticket for verification.",
  "priority": "Normal"
}

> {% client.global.set("admin_ticket_id", response.body.id); %}


### Create ticket as Agent - should return 403 Forbidden
POST {{SupportDesk_Host}}/api/tickets
Authorization: Bearer {{agent_token}}
Content-Type: application/json

{
  "title": "Agent should not create ticket",
  "description": "This request should be forbidden.",
  "priority": "High"
}


### Create ticket without token - should return 401 Unauthorized
POST {{SupportDesk_Host}}/api/tickets
Content-Type: application/json

{
  "title": "Unauthorized ticket",
  "description": "This request should be unauthorized.",
  "priority": "High"
}


### Get ticket by id as User
GET {{SupportDesk_Host}}/api/tickets/{{ticket_id}}
Authorization: Bearer {{user_token}}
Accept: application/json


### Get ticket by id as Agent
GET {{SupportDesk_Host}}/api/tickets/{{ticket_id}}
Authorization: Bearer {{agent_token}}
Accept: application/json


### Get ticket by id as Admin
GET {{SupportDesk_Host}}/api/tickets/{{ticket_id}}
Authorization: Bearer {{admin_token}}
Accept: application/json


### Ticket list as User
GET {{SupportDesk_Host}}/api/tickets
Authorization: Bearer {{user_token}}
Accept: application/json


### Ticket list as Agent
GET {{SupportDesk_Host}}/api/tickets
Authorization: Bearer {{agent_token}}
Accept: application/json


### Ticket list as Admin
GET {{SupportDesk_Host}}/api/tickets
Authorization: Bearer {{admin_token}}
Accept: application/json


### List tickets: first page, 5 tickets
GET {{SupportDesk_Host}}/api/tickets?page=1&pageSize=5
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets: second page, 5 tickets
GET {{SupportDesk_Host}}/api/tickets?page=2&pageSize=5
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets by status
GET {{SupportDesk_Host}}/api/tickets?status=New
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets by multiple statuses
GET {{SupportDesk_Host}}/api/tickets?status=New&status=InProgress
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets by priority
GET {{SupportDesk_Host}}/api/tickets?priority=High
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets by status and priority
GET {{SupportDesk_Host}}/api/tickets?status=InProgress&priority=High
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets sorted by created date ascending
GET {{SupportDesk_Host}}/api/tickets?sortBy=CreatedAt&sortDirection=Ascending
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets sorted by created date descending
GET {{SupportDesk_Host}}/api/tickets?sortBy=CreatedAt&sortDirection=Descending
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets sorted by priority ascending
GET {{SupportDesk_Host}}/api/tickets?sortBy=Priority&sortDirection=Ascending
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets sorted by priority descending
GET {{SupportDesk_Host}}/api/tickets?sortBy=Priority&sortDirection=Descending
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets sorted by status ascending
GET {{SupportDesk_Host}}/api/tickets?sortBy=Status&sortDirection=Ascending
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets sorted by status descending
GET {{SupportDesk_Host}}/api/tickets?sortBy=Status&sortDirection=Descending
Authorization: Bearer {{user_token}}
Accept: application/json


### List tickets with filters, sorting and pagination
GET {{SupportDesk_Host}}/api/tickets?status=New&status=InProgress&priority=High&page=1&pageSize=20&sortBy=CreatedAt&sortDirection=Descending
Authorization: Bearer {{user_token}}
Accept: application/json


### Bad request exception - page must be >= 1
GET {{SupportDesk_Host}}/api/tickets?page=0
Authorization: Bearer {{user_token}}
Accept: application/json


### Bad request 400 exception - pageSize must be >= 1
GET {{SupportDesk_Host}}/api/tickets?pageSize=0
Authorization: Bearer {{user_token}}
Accept: application/json


### Bad request 400 exception - pageSize must be <= 100
GET {{SupportDesk_Host}}/api/tickets?pageSize=101
Authorization: Bearer {{user_token}}
Accept: application/json


### Assign ticket as Agent
POST {{SupportDesk_Host}}/api/tickets/{{ticket_id}}/assign
Authorization: Bearer {{agent_token}}
Content-Type: application/json

{
  "agentId": "{{agent_id}}"
}


### Assign ticket as User - should return 403 Forbidden
POST {{SupportDesk_Host}}/api/tickets/{{ticket_id}}/assign
Authorization: Bearer {{user_token}}
Content-Type: application/json

{
  "agentId": "{{agent_id}}"
}


### Assign ticket as Agent to random GUID - should return 400 Bad Request
POST {{SupportDesk_Host}}/api/tickets/{{ticket_id}}/assign
Authorization: Bearer {{agent_token}}
Content-Type: application/json

{
  "agentId": "019e1111-1111-7111-8111-111111111111"
}


### Assign ticket as Admin to random GUID - should return 400 Bad Request
POST {{SupportDesk_Host}}/api/tickets/{{ticket_id}}/assign
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "agentId": "019e2222-2222-7222-8222-222222222222"
}


### Assign ticket as Admin to Agent
POST {{SupportDesk_Host}}/api/tickets/{{ticket_id}}/assign
Authorization: Bearer {{admin_token}}
Content-Type: application/json

{
  "agentId": "{{agent_id}}"
}


